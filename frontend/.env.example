# NovaKrishi Frontend Environment Configuration

# Backend API Base URL
# Production: Deployed Render backend service
# Development: http://localhost:5000 (or leave empty to use Vite dev proxy)
VITE_API_URL=https://novakrishi.onrender.com

# Razorpay Test Mode flag ('true' for test sandbox, 'false' for live)
VITE_RAZORPAY_TEST_MODE=true
